# OpenAI-compatible LLM endpoint used for metadata extraction, event/profile
# construction, query intent parsing, evidence selection, and answer generation.
ATOMMEM_API_KEY=your_api_key_here
ATOMMEM_API_BASE=https://api.openai.com/v1
ATOMMEM_LLM_MODEL=gpt-4o-mini

# Optional: separate Fact Executor endpoint for extracting atomic facts from
# raw split_samples conversations. If omitted, AtomMem reuses the LLM settings.
ATOMMEM_FACT_EXECUTOR_API_KEY=
ATOMMEM_FACT_EXECUTOR_API_BASE=
ATOMMEM_FACT_EXECUTOR_MODEL=

# Optional: separate LLM-as-a-Judge endpoint for LoCoMo evaluation.
# These defaults mirror the original benchmark judging script.
ATOMMEM_JUDGE_API_KEY=
ATOMMEM_JUDGE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
ATOMMEM_JUDGE_MODEL=deepseek-v4-pro

# Local embedding model. The default downloads from Hugging Face on first use.
ATOMMEM_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Event attribution retrieval and scoring.
ATOMMEM_EVENT_ATTRIBUTION_TOP_K=10
ATOMMEM_EVENT_ATTRIBUTION_EMBEDDING_WEIGHT=0.7
ATOMMEM_EVENT_ATTRIBUTION_KEYWORD_WEIGHT=0.3

# Runtime output locations.
ATOMMEM_FACTS_DIR=runs/default_memory
ATOMMEM_PROMPTS_DIR=prompts
